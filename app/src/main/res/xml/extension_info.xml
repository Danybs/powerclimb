<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    id="powerclimb"
    displayName="@string/extension_name"
    icon="@drawable/ic_powerclimb"
    scansDevices="false"
    fitFile="false">

    <DataType
        typeId="climb-avg-power"
        displayName="@string/datatype_name_numeric"
        description="@string/datatype_description_numeric"
        graphical="true"
        icon="@drawable/ic_powerclimb" />

    <DataType
        typeId="climb-avg-power-visual"
        displayName="@string/datatype_name_visual"
        description="@string/datatype_description_visual"
        graphical="true"
        icon="@drawable/ic_powerclimb" />

    <DataType
        typeId="climb-avg-power-zone"
        displayName="@string/datatype_name_zone"
        description="@string/datatype_description_zone"
        graphical="true"
        icon="@drawable/ic_powerclimb" />

</ExtensionInfo>
