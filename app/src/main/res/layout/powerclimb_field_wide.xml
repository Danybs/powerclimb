<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/field_value"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="relative"
        android:gravity="end|bottom"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:paddingRight="4dp"
        android:maxLines="1"
        android:text="@string/field_empty"
        android:textColor="@color/pc_text_primary"
        android:textSize="90sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingLeft="9dp"
        android:paddingRight="4dp">

        <ImageView
            android:id="@+id/field_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_powerclimb" />

        <TextView
            android:id="@+id/field_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="ibm-plex-sans-condensed"
            android:gravity="end|center_vertical"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="@string/field_label"
            android:textColor="@color/pc_text_secondary"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
