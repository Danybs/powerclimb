<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="6dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/field_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_powerclimb" />

        <TextView
            android:id="@+id/field_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="ibm-plex-sans-condensed"
            android:gravity="start|center_vertical"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="@string/field_label"
            android:textColor="@color/pc_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/field_value"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="relative"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:maxLines="1"
            android:text="@string/field_empty"
            android:textColor="@color/pc_text_primary"
            android:textSize="64sp" />

        <LinearLayout
            android:id="@+id/field_visual"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/field_ball"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/field_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_ring" />

                <TextView
                    android:id="@+id/field_ball_value"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="relative"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:maxLines="1"
                    android:text="@string/field_empty"
                    android:textColor="@color/pc_text_primary"
                    android:textSize="36sp" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/field_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/field_dot_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_4"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_5"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_6"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_7"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_8"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_9"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />

                <ImageView
                    android:id="@+id/field_dot_10"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/pc_dot" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
